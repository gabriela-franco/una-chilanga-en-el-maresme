---
interface Props {
  color?: string;
}
const { color = "#f4b6c2" } = Astro.props;
---
{/* Diente de león: flor resiliente que florece donde cae — símbolo de la migración y la fortaleza */}
<svg class="flor-simbolo" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <path d="M32 30c-1 8-1 16 0 24" stroke="#5fae87" stroke-width="2.6" stroke-linecap="round" />
  <path d="M32 46c-3 2-6 3-9 2" stroke="#5fae87" stroke-width="2" stroke-linecap="round" fill="none" />

  <g stroke={color} stroke-width="2" stroke-linecap="round">
    <line x1="32" y1="20" x2="32" y2="5" />
    <line x1="32" y1="20" x2="43.6" y2="8.4" />
    <line x1="32" y1="20" x2="50" y2="16" />
    <line x1="32" y1="20" x2="52" y2="25" />
    <line x1="32" y1="20" x2="50" y2="34" />
    <line x1="32" y1="20" x2="43.6" y2="41.6" />
    <line x1="32" y1="20" x2="32" y2="45" />
    <line x1="32" y1="20" x2="20.4" y2="41.6" />
    <line x1="32" y1="20" x2="14" y2="34" />
    <line x1="32" y1="20" x2="12" y2="25" />
    <line x1="32" y1="20" x2="14" y2="16" />
    <line x1="32" y1="20" x2="20.4" y2="8.4" />
  </g>
  <g fill={color}>
    <circle cx="32" cy="5" r="2.4" /><circle cx="43.6" cy="8.4" r="2.4" />
    <circle cx="50" cy="16" r="2.4" /><circle cx="52" cy="25" r="2.4" />
    <circle cx="50" cy="34" r="2.4" /><circle cx="43.6" cy="41.6" r="2.4" />
    <circle cx="32" cy="45" r="2.4" /><circle cx="20.4" cy="41.6" r="2.4" />
    <circle cx="14" cy="34" r="2.4" /><circle cx="12" cy="25" r="2.4" />
    <circle cx="14" cy="16" r="2.4" /><circle cx="20.4" cy="8.4" r="2.4" />
  </g>
  <circle cx="32" cy="20" r="4.5" fill={color} />

  <!-- semillas que viajan con el viento -->
  <g stroke={color} stroke-width="1.6" stroke-linecap="round">
    <line x1="56" y1="10" x2="60.5" y2="5.5" />
    <line x1="56" y1="10" x2="58.5" y2="12.5" />
    <line x1="56" y1="10" x2="53" y2="6.5" />
  </g>
  <circle cx="56" cy="10" r="2" fill={color} />

  <g stroke={color} stroke-width="1.4" stroke-linecap="round">
    <line x1="60" y1="24" x2="63.5" y2="20.5" />
    <line x1="60" y1="24" x2="62" y2="26.5" />
    <line x1="60" y1="24" x2="57.5" y2="21.5" />
  </g>
  <circle cx="60" cy="24" r="1.6" fill={color} />
</svg>
