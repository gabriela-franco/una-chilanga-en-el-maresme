---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Newsletter from '../components/Newsletter.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Blog personal sobre duelo, migración, maternidad, neurodivergencias y salud emocional, escrito desde el Maresme." } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title} · Una Chilanga en el Maresme</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Quicksand:wght@400;500;600;700&family=Caveat:wght@600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <main class="contenedor">
      <slot />
      <Newsletter />
    </main>
    <Footer />
    {import.meta.env.PROD && (
      <script
        data-goatcounter="https://chilangamaresme.goatcounter.com/count"
        async
        src="//gc.zgo.at/count.js"
      ></script>
    )}
  </body>
</html>
