---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Divisor from '../components/Divisor.astro';
import TarjetaPost from '../components/TarjetaPost.astro';
import FlorSimbolo from '../components/FlorSimbolo.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
---
<BaseLayout title="Inicio">
  <section class="hero-split">
    <div class="hero-texto">
      <h1>Una Chilanga <span class="acento">en el Maresme</span></h1>
      <p>
        Historias sin filtros desde el Maresme, con acento mexicano.
      </p>
      <p style="margin-top: 1.6rem;">
        <a class="boton" href="/blog">Leer el blog</a>
      </p>
    </div>
    <div class="hero-foto">
      <img src="/images/cascada.png" alt="Foto de Gaby" />
      <FlorSimbolo color="#f4b6c2" />
    </div>
  </section>

  <Divisor />

  {posts.length > 0 && (
    <section>
      <h2 class="seccion-titulo" style="text-align:center;">Últimos posts</h2>
      <div class="grid-posts">
        {posts.map((post) => (
          <TarjetaPost
            slug={post.id}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            category={post.data.category}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
